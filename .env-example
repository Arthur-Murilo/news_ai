# LLM provider
# Valores suportados: google ou ollama.
PROVIDER_LLM=google

# Google AI (Gemini)
# Obrigatoria somente quando PROVIDER_LLM=google.
GOOGLE_API_KEY=your_google_api_key_here

# Ollama
# Para Ollama local, mantenha a URL padrao e deixe OLLAMA_API_KEY vazio.
# Para Ollama Cloud direto pela API, use https://ollama.com e informe a chave.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=

# Modelos por agente
# Se PROVIDER_LLM=google, use nomes Gemini. Se PROVIDER_LLM=ollama, use nomes Ollama.
MODEL_AGENT_SEARCH=gemini-2.5-flash
MODEL_AGENT_FORMATER=gemini-2.5-flash
# Fallback opcional caso nao queira separar por agente.
AI_MODEL=

# Tavily Search API
# Obrigatoria para a busca de noticias.
TAVILY_API_KEY=your_tavily_api_key_here

# Resend API
# Remetente e destinatario podem ser ajustados por ambiente.
RESEND_API_KEY=your_resend_api_key_here
NEWSLETTER_FROM_EMAIL=onboarding@resend.dev
NEWSLETTER_TO_EMAIL=your_email@example.com

# Workflow settings
# Tema inicial enviado ao fluxo principal.
SUBJECT=Inteligencia Artificial
# Janela de busca em dias. Mantido entre 1 e 30.
BEFORE_DAYS=7
# Limite maximo de resultados por busca. Mantido entre 1 e 20.
MAX_SEARCH_RESULTS=15

# Scheduler settings
# Frequencia: daily, weekly ou monthly.
SCHEDULE_FREQUENCY=daily
# Hora de execucao no timezone America/Sao_Paulo.
SCHEDULE_HOUR=17
# Usado somente com weekly. 1=segunda, 7=domingo.
SCHEDULE_WEEKDAY=1
# Usado somente com monthly.
SCHEDULE_DAY=1
